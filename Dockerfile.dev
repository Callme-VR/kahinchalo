# Development Dockerfile for KahinChale
# Optimized for hot reloading and local development

FROM oven/bun:1.1.20-alpine

WORKDIR /app

# Install dependencies first for better caching
COPY package.json bun.lock ./
RUN bun install

# Copy prisma schema for generation
COPY prisma ./prisma/

# Generate Prisma client (local development will overlay src, but this ensures a base exists)
RUN bun prisma generate

# Set environment
ENV NODE_ENV=development
ENV PORT=5000

# Expose port
EXPOSE 5000

# Default command
CMD ["bun", "run", "dev"]
